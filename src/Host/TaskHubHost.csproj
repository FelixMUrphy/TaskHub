<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskHubHost</AssemblyName>
    <RootNamespace>TaskHub</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>taskhub.ico</ApplicationIcon>
    <Product>TaskHub</Product>
    <AssemblyTitle>TaskHub</AssemblyTitle>
    <Version>2.5.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- CLI single-file exe built first by build.cmd and embedded as payload -->
    <CliExe>$(MSBuildThisFileDirectory)..\..\obj\cli\taskhub.exe</CliExe>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\ui.html" LogicalName="ui.html" />
    <EmbeddedResource Include="..\..\API.md" LogicalName="API.md" />
    <EmbeddedResource Include="..\..\clients\python\taskhub_client.py" LogicalName="taskhub_client.py" />
    <EmbeddedResource Include="$(CliExe)" LogicalName="taskhub.exe" Condition="Exists('$(CliExe)')" />
  </ItemGroup>
</Project>
