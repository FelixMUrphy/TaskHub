<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DefineConstants Condition="'$(Beta)' == 'true'">$(DefineConstants);BETA</DefineConstants>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>taskhub</AssemblyName>
    <RootNamespace>TaskHubCli</RootNamespace>
    <Version>4.1.0</Version>
    <Product>TaskHub CLI</Product>
    <ApplicationIcon>..\Host\taskhub.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- the agents' settings files: the CLI cleans them up after the Store edition was uninstalled (StoreCleanup) -->
    <Compile Include="..\Host\AgentFiles.cs" Link="AgentFiles.cs" />
    <Compile Include="..\Host\LogMask.cs" Link="LogMask.cs" />
  </ItemGroup>
</Project>
